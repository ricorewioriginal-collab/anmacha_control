{
  "name": "airdeck",
  "version": "0.4.0",
  "private": true,
  "description": "AirDeck – unabhängige Radio-Automation (Windows, Android, Self-Hosted)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "token": "node src/server/main.ts --new-admin-token",
    "test": "node --test --test-timeout=120000 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p studio/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "build": "node scripts/build.mjs",
    "build:win": "node scripts/build.mjs --sea",
    "build:linux-deb": "node scripts/build.mjs --sea && node scripts/build-deb.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/omggif": "^1.0.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.12",
    "jsqr": "^1.4.0",
    "omggif": "^1.0.10",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^4.0.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "mysql2": "^3.24.4",
    "pg": "^8.23.0"
  }
}
