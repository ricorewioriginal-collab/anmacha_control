# AirDeck-Demo-Image: voll funktionsfaehige, aber isolierte Testinstanz.
# ffmpeg + ein nur containerintern erreichbarer Icecast sind enthalten, damit Automation,
# Encoder, AirDeckCast, HLS und echte Audio-Ausgabe in der Demo funktionieren. Die Instanz wird
# alle 10 Minuten verworfen und enthaelt keine produktiven Zugangsdaten.
FROM node:22-slim

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates tini ffmpeg icecast2 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY src ./src
COPY studio ./studio
COPY README.md HAFTUNGSAUSSCHLUSS.md ./
COPY packaging/demo/demo-banner.js ./studio/demo-banner.js
COPY packaging/demo/icecast.demo.xml ./packaging/demo/icecast.demo.xml
COPY packaging/demo/start-demo.sh ./packaging/demo/start-demo.sh
RUN chmod +x ./packaging/demo/start-demo.sh
# Deutlich sichtbarer Hinweis "Testinstanz" in jeder Ansicht - nur im Demo-Image, die normale
# Studio-Auslieferung (Windows/Android/Server) bleibt davon unberührt.
RUN for f in index.html handy.html hoerer.html; do \
      sed -i 's#</body>#<script src="/demo-banner.js" defer></script></body>#' "./studio/$f"; \
    done

ENV NODE_ENV=production \
    AIRDECK_DATA=/data \
    AIRDECK_HOST=0.0.0.0 \
    AIRDECK_PORT=8750

RUN mkdir -p /data/icecast-logs && chown -R node:node /data
USER node
VOLUME ["/data"]
EXPOSE 8750

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.AIRDECK_PORT||8750)+'/api/v1/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["./packaging/demo/start-demo.sh"]
